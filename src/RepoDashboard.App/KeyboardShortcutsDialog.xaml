<Window x:Class="RepoDashboard.App.KeyboardShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts" Height="520" Width="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom"
                Content="Close"
                Width="90"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                IsDefault="True"
                IsCancel="True" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Navigation"
                           FontWeight="Bold" Margin="0,0,0,4" />
                <Grid Margin="8,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Up / Down" FontFamily="Consolas" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Select previous / next repository" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Home / End" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="First / last repository" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="PageUp / PageDown" FontFamily="Consolas" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Move by page" TextWrapping="Wrap" />
                </Grid>

                <TextBlock Text="Repository management"
                           FontWeight="Bold" Margin="0,4,0,4" />
                <Grid Margin="8,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+N" FontFamily="Consolas" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Add repositories" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+Shift+N" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Discover repositories" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="F2" FontFamily="Consolas" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Rename repository" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Alt+Up" FontFamily="Consolas" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Move repository up" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Alt+Down" FontFamily="Consolas" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Move repository down" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Delete" FontFamily="Consolas" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Remove from dashboard (files are kept)" TextWrapping="Wrap" />
                </Grid>

                <TextBlock Text="Git operations"
                           FontWeight="Bold" Margin="0,4,0,4" />
                <Grid Margin="8,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="F5" FontFamily="Consolas" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Refresh selected repository" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Shift+F5" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Refresh all repositories" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="F6" FontFamily="Consolas" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Fetch selected repository" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Shift+F6" FontFamily="Consolas" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Fetch all repositories" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+F7" FontFamily="Consolas" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Update selected repository (safe fast-forward only)" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl+Shift+F7" FontFamily="Consolas" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Update all safe repositories" TextWrapping="Wrap" />
                </Grid>

                <TextBlock Text="Utilities"
                           FontWeight="Bold" Margin="0,4,0,4" />
                <Grid Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Esc" FontFamily="Consolas" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Cancel running operation" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Enter" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Open repository folder" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Enter" FontFamily="Consolas" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Open terminal" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Shift+C" FontFamily="Consolas" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Copy repository path" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="F1" FontFamily="Consolas" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Show this reference" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
