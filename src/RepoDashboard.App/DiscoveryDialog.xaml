<Window x:Class="RepoDashboard.App.DiscoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select repositories to add" Height="420" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Title}"
                   FontWeight="Bold" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="Add Selected"
                    Width="110" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="AddSelected_Click" />
            <Button Content="Cancel"
                    Width="90"
                    IsCancel="True" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Options}"
                 SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  IsEnabled="{Binding IsSelectable}"
                                  VerticalAlignment="Center" />
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{Binding DisplayText}"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding DetailsText}"
                                       Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
