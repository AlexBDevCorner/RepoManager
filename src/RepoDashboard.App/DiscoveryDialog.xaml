<Window x:Class="RepoDashboard.App.DiscoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select repositories to add" Height="420" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Title}"
                   FontWeight="Bold" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="Add Selected"
                    Width="110" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="AddSelected_Click" />
            <Button Content="Cancel"
                    Width="90"
                    IsCancel="True" />
        </StackPanel>
        <!-- Task 52: arrow keys move, Space toggles, Ctrl+A selects all
             available, Ctrl+Shift+A clears, Enter confirms (IsDefault),
             Esc cancels (IsCancel). CheckBoxes are not focusable so
             focus stays on the ListBox for keyboard navigation. -->
        <ListBox ItemsSource="{Binding Options}"
                 SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                 SelectionMode="Single">
            <ListBox.InputBindings>
                <KeyBinding Gesture="Space"
                            Command="{Binding ToggleSelectedCommand}" />
                <KeyBinding Gesture="Ctrl+A"
                            Command="{Binding SelectAllCommand}" />
                <KeyBinding Gesture="Ctrl+Shift+A"
                            Command="{Binding ClearSelectionCommand}" />
            </ListBox.InputBindings>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <CheckBox Focusable="False"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  IsEnabled="{Binding IsSelectable}"
                                  VerticalAlignment="Center" />
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{Binding DisplayText}"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding DetailsText}"
                                       Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
